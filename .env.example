# Variáveis de ambiente do agente revisor de PL/SQL.
# Copie este arquivo para .env e preencha com suas credenciais reais.
# Este arquivo NÃO deve ser versionado no Git (já está no .gitignore).

# Chave de API da Groq (opcional, se não usar Anthropic)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua-chave-groq-aqui

# Chave de API da Anthropic (opcional, se não usar Groq)
# Obtenha em: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sua-chave-anthropic-aqui

# Opcional: nome do modelo a ser usado
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, etc.
# Anthropic: claude-3-5-sonnet-20240620, claude-3-opus-20240229, etc.
REVIEWER_MODEL=llama-3.3-70b-versatile
